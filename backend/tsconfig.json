{
    "compilerOptions": {
        "target": "ES2020",
        "module": "commonjs",
        "rootDir": ".",
        "outDir": "dist",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true
    },
    "include": [
        "src",
        "src/types/**/*.d.ts",
        "prisma/seed.ts"
    ],
    "exclude": [
        "prisma/*.config.ts"
    ]
}